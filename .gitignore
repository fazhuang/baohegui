# 环境变量（含密码/密钥，严禁提交）
.env
.env.*
!.env.prod.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
dist/
frontend/.analyze/

# 数据库
*.sqlite3

# Docker 构建产物
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# 本地测试文件
/tmp/
/uploads/

# SSL 证书（生产证书不提交）
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.p12
nginx/ssl/*.pfx
!nginx/ssl/.gitkeep

# 测试运行时残留（空文件标记、临时数据库）
200
completed
backend/.test_tmp/

# 测试运行时残留数据库文件（任何位置）
*.db
*.sqlite3
backup_*.sql
backup_*.dump
